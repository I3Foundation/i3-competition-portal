# Local Postgres started by `pnpm db:up`.
# MUST be the i3_app role -- the postgres superuser bypasses RLS entirely.
DATABASE_URL=postgresql://i3_app:apppw@localhost:55432/i3

# Signs the dev session cookie. Any random string works locally.
SESSION_SECRET=dev-secret-change-me

# ---------------------------------------------------------------------------
# Phase 2a: outbound and inbound email
# ---------------------------------------------------------------------------

# Leave RESEND_API_KEY unset to use the dev transport: the full send path runs
# and is recorded, but nothing is actually emailed. This is the default so a
# fresh checkout cannot email a real teacher by accident.
# RESEND_API_KEY=re_...

# Sending subdomain. Deliberately NOT the apex, which already has forwarding MX
# records that taking over would break. Needs its own SPF, DKIM and DMARC.
MAIL_FROM_DOMAIN=mail.i3competition.com

# Absolute base URL, used to build unsubscribe links that work from an inbox.
APP_URL=http://localhost:3100

# Per team per day (per sender, for organiser recruiting). Cold email from a
# young domain is the fastest way to ruin its reputation.
SEND_CAP_PER_DAY=40

# Webhook secrets. Both verifiers FAIL CLOSED when unset: an unauthenticated
# endpoint that writes suppressions lets anyone unsubscribe your whole list.
# Resend's signing secret (Svix), from the Resend dashboard:
# RESEND_WEBHOOK_SECRET=whsec_...
# Shared secret for the inbound mail relay (a Cloudflare Email Routing Worker):
INBOUND_WEBHOOK_SECRET=dev-inbound-secret-change-me
